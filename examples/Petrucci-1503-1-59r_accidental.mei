   <music>
      <body>
         <mdiv>
            <score>
               <scoreDef>
                  <staffGrp>
                     <staffDef n="1" lines="6" notationtype="mensural.white" clef.shape="C" clef.line="3" 
                               tempus="2" prolatio="2" mensur.sign="C" mensur.slash="1"
                               keysig="1f"
                               />
                  </staffGrp>
               </scoreDef>
               <section>
                  <staff n="1">
                     <layer n="1">
                        <rest dur="longa"/>
                        <rest dur="brevis"/>
                        <rest dur="minima"/>
                        <accid accid="f" ploc="b" oloc="4"/>
                        <note dur="minima" pname="f" oct="4"/>
                        <note dur="minima" pname="g" oct="4"/>
                        <note dur="minima" pname="a" oct="4"/>
                        <note dur="semibrevis" pname="b" oct="4" accid.ges="f" num="2" numbase="3"/>
                        <dot form="aug"/>
                        <note dur="minima" pname="a" oct="4"/>
                        <note dur="semibrevis" pname="g" oct="4"/>
                        <note dur="semibrevis" pname="f" oct="4"/>
                        <note dur="brevis" pname="g" oct="4"/>
                        <rest dur="longa"/>
                        <rest dur="brevis"/>
                        <rest dur="minima"/>
                        <note dur="minima" pname="f" oct="4"/>
                        <note dur="minima" pname="g" oct="4"/>
                        <note dur="minima" pname="a" oct="4"/>
                        <note dur="semibrevis" pname="b" oct="4" accid.ges="f" num="2" numbase="3"/>
                        <dot form="aug"/>
                        <note dur="minima" pname="a" oct="4"/>
                        <note dur="semibrevis" pname="g" oct="4"/>
                        <note dur="semibrevis" pname="f" oct="4"/>
                        <note dur="brevis" pname="g" oct="4"/>
                     </layer>
                  </staff>
               </section>
            </score>
